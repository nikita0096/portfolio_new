---
import Layout from '../layouts/Layout.astro';

// --- Content (rendered statically at build time for SEO) ---

const jobs = [
	{
		years: 'jan 2025 — now',
		co: 'c10r.io',
		role: 'Frontend Engineer · Sunnyvale, CA · remote',
		note: 'End-to-end features for a Business Management SaaS Platform, from API integration to responsive UI. Cut load times 40% by batching requests and removing redundant calls; built real-time sync over SocketIO and webhooks; integrated third-party services.',
		stack: ['TypeScript', 'Next.js', 'Socket.IO', 'REST APIs', 'MongoDB', 'AI integrations'],
	},
	{
		years: 'jun 2023 — dec 2024',
		co: 'A-Fix Inc.',
		role: 'Frontend Engineer · Seattle, WA · remote',
		note: 'Internal CRM for daily operations. Simplified record creation, improved search and navigation, built reusable auto-save, improved the mobile experience and optimized i18n architecture.',
		stack: ['React', 'Next.js', 'TypeScript', 'Redux', 'PostgreSQL', 'i18n', 'Responsive UI'],
	},
	{
		years: 'sep 2019 — jan 2023',
		co: 'Ocean Estate',
		role: 'Founder & Operations Lead · Kharkiv, UA',
		note: 'Built and ran end-to-end operations for a real estate business. Designed CRM workflows for listings, clients and the sales pipeline; led the website and user flows; automated repetitive processes using analytics and business metrics.',
		stack: ['CRM workflows', 'CMS', 'Analytics', 'Automation', 'Cross-team lead'],
	},
];

const stages = [
	{ name: 'intake', desc: 'ticket: users report a slow page', live: 'received', msg: 'pm → dev: users say the page loads slowly' },
	{ name: 'sync', desc: 'team meeting: priority, scope, owner', live: 'meeting', msg: 'meeting: priority high · frontend owns the fix' },
	{ name: 'audit', desc: 'profile requests and render path', live: 'profiling', msg: 'dev: duplicate requests + oversized payloads found' },
	{ name: 'plan', desc: 'solution agreed with backend & pm', live: 'aligning', msg: 'dev → backend: agreed on data contract' },
	{ name: 'build', desc: 'fetch once, pass data down, trim queries', live: 'coding', msg: 'dev: one fetch at page level · lighter queries' },
	{ name: 'measure', desc: 'benchmark load time across user scenarios', live: 'benchmarking', msg: 'bench: load time measured across user scenarios' },
	{ name: 'ship', desc: 'result: page loads 40% faster', live: 'live', msg: 'dev → team: shipped · 40% faster · requests 3 → 1' },
];

const stackData = [
	{ name: 'JavaScript', cat: 'languages' }, { name: 'TypeScript', cat: 'languages' }, { name: 'SQL', cat: 'languages' },
	{ name: 'React', cat: 'frontend' }, { name: 'Next.js', cat: 'frontend' }, { name: 'HTML', cat: 'frontend' }, { name: 'CSS', cat: 'frontend' }, { name: 'Tailwind CSS', cat: 'frontend' },{ name: 'Astro', cat: 'frontend' },
	{ name: 'REST APIs', cat: 'apis & realtime' }, { name: 'Socket.IO', cat: 'apis & realtime' }, { name: 'WebSockets', cat: 'apis & realtime' },
	{ name: 'Redux Toolkit', cat: 'state & data' }, { name: 'Zustand', cat: 'state & data' }, { name: 'TanStack Query', cat: 'state & data' }, { name: 'PostgreSQL', cat: 'state & data' }, { name: 'MongoDB', cat: 'state & data' },
	{ name: 'Git', cat: 'tools' }, { name: 'Cloudflare', cat: 'tools' }, { name: 'Vercel', cat: 'tools' }, { name: 'Webpack', cat: 'tools' }, { name: 'Vite', cat: 'tools' }, { name: 'CI/CD', cat: 'tools' },
	{ name: 'Jest', cat: 'testing' }, { name: 'React Testing Library', cat: 'testing' }, { name: 'Playwright', cat: 'testing' },
	{ name: 'Core Web Vitals', cat: 'performance' }, { name: 'Lighthouse', cat: 'performance' }, { name: 'React DevTools Profiler,', cat: 'performance' }
];

const categories = [...new Set(stackData.map((x) => x.cat))].map((cat, k) => ({
	cat,
	no: String(k + 1).padStart(2, '0'),
	items: stackData.filter((x) => x.cat === cat).map((x) => x.name),
}));

const cookbookStack = ['Next.js', 'OAuth', 'PostgreSQL', 'Cloudflare Stream', 'Cloud storage', 'AI translation · DeepL', 'Admin CMS'];

const email = 'mykyta.zubov.dev@gmail.com';
const social = [
	{ label: 'github', href: 'https://github.com/nikita0096' },
	{ label: 'linkedin', href: 'https://www.linkedin.com/in/mykyta-zubov-a27552393/' },
];
---

<Layout>
	<div class="page">
		<!-- First screen: announcement + header + hero, sized to fit one viewport -->
		<div class="top">

		<!-- Header (desktop) -->
		<header class="hd hd--desktop">
			<nav class="hd__nav">
				<a href="#batches">experience</a><a href="#stack">stack</a><a href="#work">work</a>
			</nav>
			<a href="#top" class="hd__brand">mykyta zubov</a>
			<nav class="hd__nav hd__nav--right">
				<a href="#cv" class="js-open-cv">cv.pdf</a><a href="#contact">contact</a>
			</nav>
		</header>

		<!-- Header (compact) -->
		<header class="hd hd--compact">
			<div class="hd__row">
				<a href="#top" class="hd__brand hd__brand--sm">mykyta zubov</a>
				<a href="#cv" class="hd__cv-btn js-open-cv">cv.pdf</a>
			</div>
			<nav class="hd__nav hd__nav--compact">
				<a href="#batches">experience</a><a href="#stack">stack</a><a href="#work">work</a><a href="#contact">contact</a>
			</nav>
		</header>

		<!-- Hero -->
		<section id="top" class="hero">
			<div class="hero__intro">
				<div class="eyebrow">front-end engineer — seattle, wa</div>
				<h1 class="hero__title">complex workflows. intuitive interfaces.</h1>
				<p class="hero__lead">
					I'm a frontend engineer building production applications with React, Next.js, and TypeScript. Experienced in real-time messaging, AI-powered workflows, and complex CRM interfaces. Skilled in server-side rendering, performance optimization through caching and memoization, API integration, and component and automated testing.
				</p>
				<div class="hero__cta">
					<a href="#batches" class="btn btn--solid">experience</a>
					<a href="#contact" class="btn btn--ghost">get in touch</a>
				</div>
			</div>

			<!-- Pipeline visualization -->
			<div class="pipe" id="pipe">
				<div class="pipe__head"><span class="pipe__dot"></span>end-to-end delivery — live</div>
				<div class="pipe__task">
					<span class="eyebrow eyebrow--muted">task received</span>
					<span class="pipe__task-name">Page loads too slowly</span>
				</div>
				<div class="pipe__rail">
					<div class="pipe__rail-bg"></div>
					<div class="pipe__rail-fill" id="pipeFill"></div>
					<div class="pipe__packet" id="pipePacket"></div>
					{
						stages.map((st, k) => (
							<div class="stage" data-stage={k} data-live={st.live} data-msg={st.msg}>
								<span class="stage__dot" />
								<span class="stage__no">{String(k + 1).padStart(2, '0')}</span>
								<span class="stage__body">
									<span class="stage__name">{st.name}</span>
									<span class="stage__desc">{st.desc}</span>
								</span>
								<span class="stage__status" />
							</div>
						))
					}
				</div>
				<div class="pipe__log">
					<span class="eyebrow eyebrow--muted">communication log</span>
					<div id="pipeLog"></div>
				</div>
			</div>
		</section>
		</div>
		<!-- /top -->

		<!-- Stack -->
		<section id="stack" class="stack">
			<div class="sec-head">
				<div class="sec-head__titles">
					<span class="eyebrow">ingredients</span>
					<h2 class="sec-title">the stack</h2>
				</div>
			</div>
			<div class="stack__list">
				{
					categories.map((g, k) => (
						<div class="stack__row" style={`--i:${k}`}>
							<span class="stack__cat">
								{g.no} — {g.cat}
							</span>
							<div class="stack__items">
								{g.items.map((name) => (
									<span class="stack__item">{name}</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- Experience carousel -->
		<section id="batches" class="batches" data-count={jobs.length}>
			<div class="sec-head">
				<div class="sec-head__titles">
					<span class="eyebrow">2019 — now</span>
					<h2 class="sec-title">experience</h2>
				</div>
				<div class="batches__ctrl">
					<span class="batches__counter" id="batchCounter">01 / {String(jobs.length).padStart(2, '0')}</span>
					<div class="batches__btns">
						<button class="nav-btn js-prev" aria-label="Previous">←</button>
						<button class="nav-btn js-next" aria-label="Next">→</button>
					</div>
				</div>
			</div>
			<div class="batches__view">
				<div class="batches__track" id="batchTrack">
					{
						jobs.map((j, k) => (
							<article class="slide" data-slide={k}>
								<div class="slide__head">
									<span class="eyebrow">
										no. {String(k + 1).padStart(2, '0')} — {j.years}
									</span>
									<span class="slide__co">{j.co}</span>
									<span class="slide__role">{j.role}</span>
								</div>
								<div class="slide__body">
									<p class="slide__note">{j.note}</p>
									<div class="slide__stack">
										<span class="eyebrow eyebrow--muted">stack used</span>
										<div class="chips">
											{j.stack.map((c) => (
												<span class="chip">{c}</span>
											))}
										</div>
									</div>
								</div>
							</article>
						))
					}
				</div>
			</div>
			<div class="batches__tabs" id="batchTabs">
				{
					jobs.map((j, k) => (
						<button class="tab" data-tab={k} aria-label={`Show ${j.co}`}>
							<span class="tab__bar">
								<span class="tab__fill" />
							</span>
							<span class="tab__label">{j.co}</span>
						</button>
					))
				}
			</div>
		</section>

		<!-- Selected work -->
		<section id="work" class="work">
			<div class="sec-head sec-head--baseline">
				<h2 class="sec-title">selected work</h2>
				<span class="eyebrow">01 released · 01 in progress</span>
			</div>
			<div class="work__grid">
				<a href="https://thecookbookys.com/en" target="_blank" rel="noopener" class="work-card">
					<div class="work-card__panel">
						<div class="work-card__meta">
							<span class="eyebrow eyebrow--muted eyebrow--xs">thecookbookys.com · en / ua</span>
							<div class="work-card__desc">
								<span class="work-card__name">personal recipe book</span>
								<span class="work-card__text">
									An author's baking platform: browse recipes, save favorites and unlock premium ones with
									step-by-step video. Content is managed through a custom admin CMS.
								</span>
							</div>
							<span class="work-card__tag">browse recipes</span>
						</div>
						<div class="work-card__built">
							<span class="eyebrow eyebrow--muted eyebrow--xs">built with</span>
							{
								cookbookStack.map((s, i) => (
									<div class="built-row">
										<span class="built-row__no">{String(i + 1).padStart(2, '0')}</span>
										<span class="built-row__name">{s}</span>
									</div>
								))
							}
						</div>
					</div>
					<div class="work-card__foot">
						<span>no. 01</span><span>live ↗</span>
					</div>
					<div class="work-card__title">The CookBook by YS</div>
				</a>

				<div class="work-next">
					<div class="work-next__box">
						<span class="work-next__badge"><span class="work-next__blink" id="workBlink"></span>in progress</span>
						<span class="work-next__name">next batch</span>
						<span class="work-next__text">Something new is being composed. Label printed on release.</span>
					</div>
					<div class="work-card__foot"><span>no. 02</span><span>2026 —</span></div>
					<div class="work-card__title work-card__title--muted">Future project</div>
				</div>
			</div>
		</section>

		<!-- Contact -->
		<section id="contact" class="contact">
			<div class="eyebrow">Get in touch</div>
			<a href={`mailto:${email}`} class="contact__email">{email}</a>
			<div class="contact__social">
				{social.map((s) => (
					<a href={s.href} target="_blank" rel="noopener">
						{s.label}
					</a>
				))}
				<a href="#cv" class="hd__cv-btn js-open-cv">cv.pdf</a>
			</div>
		</section>

		<footer class="footer"><span>© 2026 mykyta zubov</span></footer>

		<!-- CV modal (PDF loaded lazily, on demand) -->
		<div class="cv" id="cvModal" hidden>
			<div class="cv__backdrop js-close-cv"></div>
			<div class="cv__dialog" role="dialog" aria-modal="true" aria-label="Resume — Mykyta Zubov">
				<div class="cv__bar">
					<span>resume — mykyta zubov</span>
					<button class="cv__close js-close-cv" aria-label="Close">✕</button>
				</div>
				<div class="cv__body" id="cvBody">
					<!-- iframe injected here on first open -->
				</div>
			</div>
		</div>
	</div>
</Layout>

<style>
	.page {
		min-height: 100vh;
	}

	.eyebrow {
		font-size: 11px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.eyebrow--muted {
		color: var(--muted);
		font-size: 10px;
	}
	.eyebrow--xs {
		font-size: 9px;
	}

	/* Header */
	.hd {
		border-bottom: 0.5px solid var(--line);
	}
	.hd--desktop {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 24px;
		padding: 22px clamp(20px, 4vw, 56px);
	}
	.hd--compact {
		display: none;
	}
	.hd__nav {
		display: flex;
		gap: 28px;
		font-size: 11px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.hd__nav--right {
		justify-content: flex-end;
	}
	.hd__brand {
		font-family: var(--display);
		font-weight: 600;
		font-size: 22px;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		white-space: nowrap;
		text-align: center;
	}
	.hd__row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		padding: 16px 20px;
	}
	.hd__brand--sm {
		font-size: 17px;
		letter-spacing: 0.22em;
	}
	.hd__cv-btn {
		border: 0.5px solid var(--ink);
		padding: 9px 14px;
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.hd__nav--compact {
		justify-content: space-between;
		gap: 16px;
		padding: 12px 20px;
		border-top: 0.5px solid var(--line-soft);
		font-size: 10px;
	}

	@media (max-width: 759px) {
		.hd--desktop {
			display: none;
		}
		.hd--compact {
			display: block;
		}
	}

	/* Hero */
	.hero {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
		gap: 0.5px;
		background: var(--line);
		border-bottom: 0.5px solid var(--line);
	}
	.hero__intro {
		padding: clamp(40px, 7vw, 96px) clamp(20px, 4vw, 56px);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: clamp(28px, 5vw, 48px);
		background: var(--bg);
	}
	.hero__title {
		margin: 0;
		font-family: var(--display);
		font-weight: 500;
		font-size: clamp(44px, 7vw, 96px);
		line-height: 0.95;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		text-wrap: balance;
	}
	.hero__lead {
		margin: 0;
		max-width: 44ch;
		text-wrap: pretty;
	}
	.hero__cta {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.btn--solid {
		background: var(--ink);
		color: var(--bg);
		padding: 14px 26px;
	}
	.btn--solid:hover {
		background: #3a3835;
		color: var(--bg);
	}
	.btn--ghost {
		border: 0.5px solid var(--ink);
		padding: 13px 26px;
	}
	.btn--ghost:hover {
		background: var(--ink);
		color: var(--bg);
	}

	/* First screen: fit announcement + header + hero into one viewport (desktop) */
	@media (min-width: 760px) {
		.top {
			min-height: 100svh;
			display: flex;
			flex-direction: column;
		}
		.hero {
			flex: 1 1 auto;
			min-height: 0;
		}
		.hero__intro {
			justify-content: center;
			gap: clamp(18px, 3vh, 36px);
			padding-block: clamp(24px, 4vh, 64px);
		}
		.hero__title {
			font-size: clamp(40px, 5.2vw, 72px);
		}
		.pipe {
			min-height: 0;
			gap: clamp(14px, 2.2vh, 24px);
			padding-block: clamp(20px, 3vh, 40px);
		}
		.pipe__rail {
			min-height: 0;
		}
	}

	/* Pipeline */
	.pipe {
		position: relative;
		background: var(--panel);
		padding: clamp(28px, 4vw, 48px) clamp(24px, 4vw, 52px);
		display: flex;
		flex-direction: column;
		gap: 28px;
		min-height: 560px;
		overflow: hidden;
	}
	.pipe__head {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted-2);
	}
	.pipe__dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--ink);
		animation: pulseDot 1.6s ease-in-out infinite;
	}
	.pipe__task {
		display: grid;
		gap: 6px;
		border-bottom: 0.5px solid var(--line);
		padding-bottom: 18px;
	}
	.pipe__task-name {
		font-family: var(--display);
		font-weight: 500;
		font-size: clamp(22px, 2.2vw, 30px);
		letter-spacing: 0.03em;
		text-transform: uppercase;
		line-height: 1.05;
		text-wrap: balance;
	}
	.pipe__rail {
		position: relative;
		flex: 1;
		display: grid;
		grid-template-rows: repeat(7, minmax(0, 1fr));
		min-height: 340px;
	}
	.pipe__rail-bg {
		position: absolute;
		left: 6px;
		top: calc(100% / 14);
		bottom: calc(100% / 14);
		width: 0.5px;
		background: rgba(26, 25, 24, 0.3);
	}
	.pipe__rail-fill {
		position: absolute;
		left: 6px;
		top: calc(100% / 14);
		width: 0.5px;
		height: 0%;
		background: var(--ink);
		transition: height 0.9s cubic-bezier(0.6, 0, 0.2, 1);
	}
	.pipe__packet {
		position: absolute;
		left: 0;
		width: 13px;
		height: 13px;
		margin-top: -6.5px;
		top: 7%;
		border-radius: 50%;
		background: var(--ink);
		box-shadow: 0 0 0 4px rgba(26, 25, 24, 0.12);
		transition: top 0.9s cubic-bezier(0.6, 0, 0.2, 1);
		z-index: 2;
	}
	.stage {
		display: grid;
		grid-template-columns: 13px 30px minmax(0, 1fr) auto;
		gap: 10px;
		align-items: center;
		opacity: 0.38;
		transition: opacity 0.5s ease;
	}
	.stage__dot {
		width: 13px;
		height: 13px;
		border-radius: 50%;
		border: 0.5px solid var(--ink);
		background: transparent;
		transition: background 0.5s ease;
	}
	.stage__no {
		font-size: 10px;
		letter-spacing: 0.1em;
		color: var(--muted);
	}
	.stage__body {
		display: grid;
		gap: 2px;
		min-width: 0;
	}
	.stage__name {
		font-family: var(--display);
		font-weight: 500;
		font-size: clamp(17px, 1.6vw, 22px);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		line-height: 1;
	}
	.stage__desc {
		font-size: 11px;
		color: var(--muted-2);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.stage__status {
		font-size: 9px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.stage.is-done {
		opacity: 0.7;
	}
	.stage.is-done .stage__dot {
		background: var(--ink);
	}
	.stage.is-active {
		opacity: 1;
	}
	.stage.is-active .stage__dot {
		background: var(--card);
	}
	.pipe__log {
		background: var(--card);
		border: 0.5px solid var(--line);
		padding: 14px 16px;
		display: grid;
		gap: 6px;
		font-size: 11px;
		min-height: 92px;
	}
	.pipe__log #pipeLog {
		display: grid;
		gap: 6px;
	}
	.log-line {
		display: flex;
		gap: 10px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		opacity: 0.5;
	}
	.log-line:last-child {
		opacity: 1;
	}
	.log-line time {
		color: var(--muted);
	}

	@media (max-width: 559px) {
		.pipe {
			min-height: 0;
		}
	}

	/* Section head */
	.sec-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 24px;
		flex-wrap: wrap;
		margin-bottom: 40px;
	}

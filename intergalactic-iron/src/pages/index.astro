		font-size: 10px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
</style>

<script>
	// ---- Experience carousel ----
	const batches = document.querySelector<HTMLElement>('.batches');
	if (batches) {
		const track = document.getElementById('batchTrack')!;
		const counter = document.getElementById('batchCounter')!;
		const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
		const total = Number(batches.dataset.count) || tabs.length;
		const DURATION = 6000;
		let i = 0;
		let paused = false;
		let progress = 0; // 0..1 elapsed within the current slide
		let last = performance.now();

		// Set every tab's bar explicitly: past = full, future = empty (pale), active = progress.
		const setFills = () => {
			tabs.forEach((tab, k) => {
				const fill = tab.querySelector<HTMLElement>('.tab__fill')!;
				const scale = k < i ? 1 : k > i ? 0 : progress;
				fill.style.transform = `scaleX(${scale})`;
				tab.classList.toggle('is-active', k === i);
				tab.classList.toggle('is-past', k < i);
			});
		};

		const renderSlide = () => {
			track.style.transform = `translate3d(-${i * 100}%,0,0)`;
			counter.textContent = `${String(i + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
			setFills();
		};

		const go = (n: number) => {
			i = (n + total) % total;
			progress = 0;
			renderSlide();
		};

		// Single clock via rAF: one `progress` value drives both the active bar and the
		// auto-advance, so the bar and the slide can never desync (no two bars moving,
		// no stalled bar). Pausing simply stops advancing `progress`.
		const tickFrame = (now: number) => {
			const dt = Math.min(now - last, 100); // clamp jumps after the tab was backgrounded
			last = now;
			if (!paused) {
				progress += dt / DURATION;
				if (progress >= 1) {
					go(i + 1);
				} else {
					tabs[i].querySelector<HTMLElement>('.tab__fill')!.style.transform = `scaleX(${progress})`;
				}
			}
			requestAnimationFrame(tickFrame);
		};

		batches.querySelector('.js-prev')?.addEventListener('click', () => go(i - 1));
		batches.querySelector('.js-next')?.addEventListener('click', () => go(i + 1));
		tabs.forEach((tab, k) => tab.addEventListener('click', () => go(k)));
		batches.addEventListener('mouseenter', () => {
			paused = true;
		});
		batches.addEventListener('mouseleave', () => {
			paused = false;
		});

		renderSlide();
		requestAnimationFrame(tickFrame);
	}

	// ---- Stack reveal on scroll ----
	const stack = document.getElementById('stack');
	if (stack) {
		const io = new IntersectionObserver(
			(entries) => {
				if (entries[0].isIntersecting) {
					stack.classList.add('is-seen');
					io.disconnect();
				}
			},
			{ threshold: 0.2 },
		);
		io.observe(stack);
	}

	// ---- Pipeline visualization ----
	const pipe = document.getElementById('pipe');
	if (pipe) {
		const stageEls = Array.from(pipe.querySelectorAll<HTMLElement>('.stage'));
		const fill = document.getElementById('pipeFill')!;
		const packet = document.getElementById('pipePacket')!;
		const logEl = document.getElementById('pipeLog')!;
		const n = stageEls.length;
		let step = -1;
		const log: { t: string; msg: string }[] = [];

		const tick = () => {
			step = (step + 1) % n;
			stageEls.forEach((s, k) => {
				s.classList.toggle('is-done', k < step);
				s.classList.toggle('is-active', k === step);
				const status = s.querySelector<HTMLElement>('.stage__status')!;
				status.textContent = k < step ? 'done' : k === step ? s.dataset.live || '' : '';
			});
			fill.style.height = `calc(100% * ${step / n})`;
			packet.style.top = `calc(100% * ${(step + 0.5) / n})`;

			const d = new Date();
			const t = d.toLocaleTimeString('en-US', {
				hour: '2-digit',
				minute: '2-digit',
				hour12: true,
			});
			log.push({ t, msg: stageEls[step].dataset.msg || '' });
			while (log.length > 3) log.shift();
			logEl.innerHTML = log
				.map(
					(l) =>
						`<div class="log-line"><time>${l.t}</time><span>${l.msg}</span></div>`,
				)
				.join('');
		};

		tick();
		setInterval(tick, 1800);
	}

	// ---- "Next batch" blink ----
	const blink = document.getElementById('workBlink');
	if (blink) {
		setInterval(() => {
			blink.style.opacity = blink.style.opacity === '0.15' ? '1' : '0.15';
		}, 900);
	}

	// ---- CV modal (PDF loaded lazily, on demand) ----
	const modal = document.getElementById('cvModal');
	if (modal) {
		const body = document.getElementById('cvBody')!;
		let loaded = false;

		const open = (e: Event) => {
			e.preventDefault();
			if (!loaded) {
				// Lazy on-demand: the PDF is only fetched the first time the button is clicked.
				body.innerHTML = '<div class="cv__loading">loading cv…</div>';
				const frame = document.createElement('iframe');
				frame.title = 'CV — Mykyta Zubov';
				// Inline styles: this iframe is created at runtime and doesn't receive
				// Astro's scoped-style attribute, so the scoped .cv__body iframe rule
				// wouldn't apply — set the sizing directly to fill the modal width.
				frame.style.cssText = 'flex:1;width:100%;height:100%;border:none;background:#fbf9f4';
				frame.src = '/cv.pdf#toolbar=0&navpanes=0&view=FitH';
				frame.addEventListener('load', () => {
					body.querySelector('.cv__loading')?.remove();
				});
				body.appendChild(frame);
				loaded = true;
			}
			modal.hidden = false;
			document.body.style.overflow = 'hidden';
		};
		const close = () => {
			modal.hidden = true;
			document.body.style.overflow = '';
		};

		document.querySelectorAll('.js-open-cv').forEach((el) => el.addEventListener('click', open));
		modal.querySelectorAll('.js-close-cv').forEach((el) => el.addEventListener('click', close));
		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !modal.hidden) close();
		});
	}
</script>